# Configure these on the storefront hosting service. Do not commit populated values.
NODE_ENV=production
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
DB_NAME=SURYAENTERPRISES
PAYU_ENV=production
PAYU_KEY=<live PayU merchant key>
PAYU_SALT=<live PayU merchant salt; identical on Payin-Backend>
PUBLIC_BASE_URL=https://www.suryaenter.in
PAYIN_API_TOKEN=<random token; identical to SURYA_PAYIN_API_TOKEN on Payin-Backend>
PAYIN_BACKEND_WEBHOOK_URL=https://www.suryaenter.in/gateway/api/webhooks/payu/payment
# Actual hosting origin of the separate Express API; used by same-domain rewrites.
PAYIN_BACKEND_ORIGIN=https://your-backend-host.example
